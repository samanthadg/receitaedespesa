#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper startup script for POSIX
# ----------------------------------------------------------------------------

BASE_DIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_DIR="$BASE_DIR/.mvn/wrapper"
WRAPPER_JAR="$WRAPPER_DIR/maven-wrapper.jar"
WRAPPER_PROPS="$WRAPPER_DIR/maven-wrapper.properties"

if [ ! -f "$WRAPPER_PROPS" ]; then
  echo "[ERROR] Missing $WRAPPER_PROPS" >&2
  exit 1
fi

WRAPPER_URL="$(grep -E '^wrapperUrl=' "$WRAPPER_PROPS" | sed -e 's/^wrapperUrl=//')"
if [ -z "$WRAPPER_URL" ]; then
  echo "[ERROR] wrapperUrl not set in $WRAPPER_PROPS" >&2
  exit 1
fi

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Downloading Maven Wrapper jar..."
  mkdir -p "$WRAPPER_DIR"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$WRAPPER_URL" -o "$WRAPPER_JAR"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$WRAPPER_URL" -O "$WRAPPER_JAR"
  else
    echo "[ERROR] Need curl or wget to download Maven Wrapper jar." >&2
    exit 1
  fi
fi

exec java ${MAVEN_OPTS:-} -classpath "$WRAPPER_JAR" -Dmaven.multiModuleProjectDirectory="$BASE_DIR" \
  org.apache.maven.wrapper.MavenWrapperMain "$@"

